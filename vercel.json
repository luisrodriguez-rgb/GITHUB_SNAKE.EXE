{
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "destination": "https://luisrodriguez-rgb.github.io/GITHUB_SNAKE.EXE/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/calendar/:user.json",
      "destination": "/api/calendar?user=:user"
    },
    {
      "source": "/api/:user.svg",
      "destination": "/api/snake?user=:user"
    }
  ],
  "functions": {
    "api/snake.js": {
      "maxDuration": 10,
      "includeFiles": "{js,shared,action}/**"
    },
    "api/calendar.js": {
      "maxDuration": 10,
      "includeFiles": "{js,shared,action}/**"
    }
  }
}
